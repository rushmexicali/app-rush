# Plantilla de variables de entorno — SIN VALORES.
# Este archivo SI se sube a Git. Sirve para saber que llaves hace falta configurar.
#
# Para usarlo: copia este archivo como ".env" y llena los valores reales ahi.
# El ".env" NUNCA se sube (esta en .gitignore).

# --- Supabase (Paso 1: panel > Project Settings > API) ---
# URL publica del proyecto, algo como https://abcdefgh.supabase.co
SUPABASE_URL=
# Llave publica (sb_publishable_...). Se puede exponer en la app; respeta las reglas RLS.
SUPABASE_PUBLISHABLE_KEY=
# Llave MAESTRA (sb_secret_...). Se salta toda la seguridad. Solo del lado del servidor.
# NUNCA dentro de la app del telefono.
SUPABASE_SECRET_KEY=

# --- Supabase CLI (Fase 2) ---
# Token de cuenta para desplegar Edge Functions desde la terminal.
# Se crea en https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# El identificador del proyecto, visible en la URL del panel.
SUPABASE_PROJECT_REF=

# --- Zettle (Paso 5: https://my.zettle.com/apps/api-keys, scope READ:PURCHASE) ---
# La API key completa (es un JWT largo). Se usa para pedir el access token.
ZETTLE_API_KEY=
# Se saca de adentro de la API key. Lo obtenemos juntos en el Paso 5.
ZETTLE_CLIENT_ID=

# --- Webhook (Paso 6) ---
# URL publica de la Edge Function, algo como
# https://abcdefgh.supabase.co/functions/v1/zettle-webhook
ZETTLE_WEBHOOK_URL=
# Lo devuelve Zettle al crear la suscripcion. Sirve para verificar firmas mas adelante.
ZETTLE_SIGNING_KEY=

# --- Codigo de acceso de la app ---
# Lo teclea el supervisor una vez en el telefono. Tambien va en los
# secretos de Supabase: supabase secrets set CODIGO_ACCESO=...
CODIGO_ACCESO=

# --- Contacto ---
# Correo al que Zettle avisa si el webhook falla.
CONTACTO_EMAIL=

# --- GitHub (para publicar la app en GitHub Pages) ---
# Token con permiso Contents: Read and write, solo sobre este repo.
GITHUB_TOKEN=

# --- Jibble (Fase 3) ---
# Jibble > Organization Settings > API Keys > Create New Secret
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=

# --- Anthropic (lectura automatica de placas) ---
# Se crea en https://console.anthropic.com > API Keys. Se muestra una sola vez.
# Empieza con sk-ant-. Tambien va en los secretos de Supabase:
# supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# --- Camara Reolink de la caja (via el relay go2rtc + Tailscale) ---
# La camara fija que fotografia el carro en la ventanilla de cobro. La IP es
# la de la camara DENTRO de la red del carwash (no la de Tailscale).
REOLINK_IP=
REOLINK_USER=
REOLINK_PASS=

# --- Tokens de las tareas de fondo -----------------------------------
# ⚠️ ESTOS DOS NO VAN EN EL .env Y SE PONEN EN **DOS** LUGARES. Se listan aqui
# porque quien reconstruya el proyecto en otra maquina no tiene forma de
# enterarse de que existen -- y sin ellos las dos tareas responden 401 para
# siempre, EN SILENCIO. Ya paso: la migracion 104 quedo a medio desplegar y el
# obrero de relectura estuvo semanas sin tomar un solo lote.
#
#   1. Como secreto de la Edge Function, que es quien lo comprueba:
#        supabase secrets set RELECTURA_TOKEN=...
#        supabase secrets set LIMPIEZA_TOKEN=...
#   2. Como secreto de Vault, que es de donde lo lee pg_cron para llamarlas:
#        select vault.create_secret('...', 'relectura_token');
#        select vault.create_secret('...', 'limpieza_token');
#
# El valor tiene que ser EL MISMO en los dos lados. Si solo se pone uno, la
# tarea no corre y no se entera nadie -- por eso desde el 24/ago las dos
# escriben un aviso en `avisos_del_sistema` cuando el secreto falta.
#
# RELECTURA_TOKEN  -> ruta /releer-pendientes de la funcion `app` (cron cada 5 min)
# LIMPIEZA_TOKEN   -> funcion `limpiar-fotos` (cron nocturno, retencion 60 dias)
